---
// One reverse gear: photo, drawing, short owner text, key values, two actions.
import type { Model } from "../lib/data";
import { modelView } from "../lib/data";
import { url } from "../lib/site";
interface Props { m: Model; level?: 2 | 3 }
const { m, level = 3 } = Astro.props;
const v = modelView[m.id];
const ph = v.photos[0];
const dr = v.drawings[0];
const H = `h${level}` as "h2" | "h3";
---
<article class="mcard">
  <div class="mmedia" class:list={[{ one: !dr }]}>
    <a href={url(`oborudovanie/${m.slug}/`)} tabindex="-1" aria-hidden="true" class="mphoto">
      <img src={url(ph.t.src)} width={ph.t.w} height={ph.t.h} alt="" loading="lazy" decoding="async" />
    </a>
    {dr && <a href={url(dr.f.src)} data-zoom class="mdraw" aria-label={`Чертёж ${m.name}: ${dr.title}`}>
      <img src={url(dr.t.src)} width={dr.t.w} height={dr.t.h} alt={`Чертёж реверс-редуктора ${m.name}`} loading="lazy" decoding="async" />
    </a>}
  </div>
  <div class="mbody">
    <p class="kind">{m.kind[0].toUpperCase() + m.kind.slice(1)} реверс-редуктор</p>
    <H><a href={url(`oborudovanie/${m.slug}/`)}>{m.name}</a> <span class="sku">{m.designation}</span></H>
    <p>{v.text[0]}</p>
    <dl class="keys">{m.keySpecs.map((k) => <div><dt>{k.label}</dt><dd>{k.value}</dd></div>)}</dl>
    <div class="btns">
      <a class="btn sm" href={url(`oborudovanie/${m.slug}/`)}>Подробнее</a>
      <a class="btn ghost sm" href={url(`katalog/${m.slug}/`)}>Каталог запчастей</a>
    </div>
  </div>
</article>
