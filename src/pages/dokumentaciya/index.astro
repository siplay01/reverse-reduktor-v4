---
import { statSync } from "node:fs";
import Base from "../../layouts/Base.astro";
import { manual, scans, assemblies } from "../../lib/data";
import { url, fmtSize, CERT } from "../../lib/site";
import Icon from "../../components/Icon.astro";
const size = fmtSize(statSync(`public/${manual.href}`).size);
const certSize = fmtSize(statSync(`public/${CERT.pdf}`).size);
---
<Base title="Документация: свидетельство РКО, руководство, каталог РР-300" section="dokumentaciya/" crumbs={[["dokumentaciya/", "Документация"]]}
  description="Свидетельство РКО, руководство по эксплуатации реверс-редукторов РР-300 и РР-238 (PDF) и каталог деталей и сборочных единиц РР-300: открыть или скачать.">
  <h1>Документация</h1>
  <p class="lead">Свидетельство о признании РКО, руководство по эксплуатации и каталог деталей реверс-редукторов РР-300 и РР-238.</p>
  <div class="docs">
    <article class="doc">
      <span class="ic" aria-hidden="true"><Icon name="certificate" size={30} /></span>
      <div>
        <h2>{CERT.title}</h2>
        <p class="muted small">ООО «Дело» · PDF, 1 стр., {certSize} · действует с {CERT.from} до {CERT.to}</p>
        <p>Разработка технической документации, дефектация и капитальный ремонт судовых реверс-редукторов, изготовление и ремонт изделий судового машиностроения.</p>
        <div class="btns"><a class="btn" href={url(CERT.pdf)} target="_blank" rel="noopener">Открыть PDF</a><a class="btn ghost" href={url(CERT.pdf)} download={`Свидетельство РКО ${CERT.no}.pdf`}>Скачать</a></div>
      </div>
    </article>
    <article class="doc">
      <span class="ic" aria-hidden="true"><Icon name="file-type-pdf" size={30} /></span>
      <div>
        <h2>{manual.title}</h2>
        <p class="muted small">РР-300 <span class="sku">СБ525-01-13</span> и РР-238 <span class="sku">СБ238-25-01-13</span> · PDF, {manual.pages} стр., {size}</p>
        <p>Устройство, монтаж, эксплуатация и техническое обслуживание, основные технические данные.</p>
        <div class="btns"><a class="btn" href={url(manual.href)} target="_blank" rel="noopener">Открыть PDF</a><a class="btn ghost" href={url(manual.href)} download="Руководство РР-300 РР-238.pdf">Скачать</a></div>
      </div>
    </article>
    <article class="doc">
      <span class="ic" aria-hidden="true"><Icon name="book" size={30} /></span>
      <div>
        <h2>Каталог деталей и сборочных единиц реверс-редуктора РР-300</h2>
        <p class="muted small">РР-300 <span class="sku">СБ525-01-13</span> · сканы, {scans.length} стр.</p>
        <p>{assemblies.length} рисунков узлов со спецификациями, номерной указатель деталей. Рисунки разобраны в <a href={url("katalog/rr-300/")}>каталоге запчастей РР-300</a>.</p>
        <div class="btns"><a class="btn" href={url("dokumentaciya/katalog-rr-300/")}>Смотреть сканы</a></div>
      </div>
    </article>
  </div>
</Base>
